# CheckSafe - environment variables
# Copy this file to `.env.local` and fill in your keys.

# Google Gemini (primary provider)
GEMINI_API_KEY=

# Groq (fallback, used when Gemini is unavailable or rate limited)
GROQ_API_KEY=

# --- Optional tuning ---
# An extra Gemini model identifier, tried before the built-in chain
# (gemini-3.8-flash, gemini-flash-latest, gemini-2.5-flash).
# GEMINI_MODEL=gemini-flash-latest
# The single Groq model used as the fallback provider.
# GROQ_MODEL=openai/gpt-oss-120b
# Per-provider time budgets, kept under maxDuration (60 s).
# GEMINI_BUDGET_MS=14000
# GROQ_BUDGET_MS=25000

# Public URL of the deployment. Used in the "share with someone you care
# about" message and in the SEO metadata.
# NEXT_PUBLIC_SITE_URL=https://check-safe-beryl.vercel.app
