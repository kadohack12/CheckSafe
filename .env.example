# CheckSafe - environment variables
# Copy this file to `.env.local` and fill in your keys.

# Google Gemini (primary provider)
GEMINI_API_KEY=

# Groq (fallback, used when Gemini is unavailable or rate limited)
GROQ_API_KEY=

# --- Optional tuning ---
# Model identifiers, tried in order. Providers retire models regularly, so
# keeping at least two entries per list lets the app switch automatically to
# a model that still exists.
# GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Ceiling for a single model attempt.
# PROVIDER_TIMEOUT_MS=8000
# Per-provider and global time budgets, kept under maxDuration (60 s).
# GEMINI_BUDGET_MS=14000
# GROQ_BUDGET_MS=25000
# TOTAL_BUDGET_MS=45000
