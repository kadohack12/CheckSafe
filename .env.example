# CheckSafe - variables d'environnement
# Copiez ce fichier en `.env.local` et renseignez vos cles.

# Google Gemini (fournisseur principal)
GEMINI_API_KEY=

# Groq (repli automatique si Gemini est indisponible ou hors quota)
GROQ_API_KEY=

# --- Options (facultatif) ---
# Identifiants de modeles, essayes dans l'ordre. Les fournisseurs retirent
# regulierement les anciens modeles : garder au moins deux entrees par liste
# permet de basculer automatiquement sur un modele encore disponible.
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Delai maximal par tentative de modele.
# PROVIDER_TIMEOUT_MS=15000
# Budget total de l'analyse, a garder sous maxDuration (60 s).
# TOTAL_BUDGET_MS=50000
